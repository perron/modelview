{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modelview/validate/v1",
  "title": "modelview validate",
  "type": "object",
  "required": ["schema", "ok", "file", "error_count", "warning_count", "info_count", "problems"],
  "properties": {
    "schema": { "const": "modelview/validate/v1" },
    "ok": { "type": "boolean" },
    "file": { "type": "string" },
    "error_count": { "type": "integer" },
    "warning_count": { "type": "integer" },
    "info_count": { "type": "integer" },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "path": { "type": "string" },
          "searched": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
